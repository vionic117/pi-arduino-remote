#!/bin/bash
set -e

cd /home/mvb/pi-remote

echo "Checking project changes..."

git add .

if git diff --cached --quiet; then
    echo "No new changes to upload."
    exit 0
fi

echo
git status --short
echo

read -r -p "Upload these changes? (yes/no): " confirm

if [ "$confirm" != "yes" ]; then
    echo "Upload cancelled."
    exit 0
fi

read -r -p "Enter a commit message: " message

if [ -z "$message" ]; then
    message="Update Arduino dashboard"
fi

git commit -m "$message"
git push origin main

echo
echo "GitHub upload completed successfully!"
